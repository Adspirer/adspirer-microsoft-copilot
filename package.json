{
  "name": "adspirer-microsoft-copilot",
  "version": "0.1.0",
  "description": "Microsoft integration workspace for Adspirer's hosted advertising MCP service.",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "validate": "node scripts/validate.mjs",
    "test": "node --test",
    "package:preview": "node scripts/package.mjs --preview",
    "package": "node scripts/package.mjs",
    "check": "npm run generate:check && npm run validate && npm test && npm run package:preview",
    "check:metadata": "node scripts/check-metadata.mjs",
    "atk": "atk --telemetry false",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adspirer/adspirer-microsoft-copilot.git"
  },
  "author": "Adspirer",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Adspirer/adspirer-microsoft-copilot/issues"
  },
  "homepage": "https://github.com/Adspirer/adspirer-microsoft-copilot#readme",
  "devDependencies": {
    "@microsoft/m365agentstoolkit-cli": "1.1.17",
    "adm-zip": "0.6.1",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "pngjs": "7.0.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
